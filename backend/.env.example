# ==============================================================================
# StructurFlow Backend Environment Variables (Template)
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (MongoDB)
MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb+srv://your_username:your_password@cluster0.example.mongodb.net"

# Redis (Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
# REDIS_URL=redis://default:your_password@your_host:your_port

# Authentication & Security (at least 10 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_10_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_10_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_at_least_10_chars

# Logging
LOG_LEVEL=info

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=noreply@example.com

# Brevo HTTP API (Recommended for Render Free Tier to bypass SMTP port blocking)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

# OTP & Signup Expiration
OTP_TTL_MINUTES=15
PENDING_SIGNUP_TTL_MINUTES=120

# Cloudinary (Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# AI / Gemini
GEMINI_API_KEY=your_gemini_api_key
