# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/structurflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT / Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-change-this

# Object Storage (configure when ready)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI Provider (configure in Phase 5)
AI_PROVIDER=openai
AI_API_KEY=

# Logging
LOG_LEVEL=debug
